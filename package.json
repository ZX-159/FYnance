{
  "name": "fynance",
  "version": "1.3.1",
  "description": "FYnance — Foon Yew eSchool e-Wallet Dashboard",
  "main": "electron/main.js",
  "author": "ESchool Tools",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:renderer": "vite build",
    "build:python": "node scripts/build-python.js",
    "build": "npm run build:renderer && npm run build:python",
    "start": "npm run build && electron .",
    "start:quick": "electron .",
    "dev:renderer": "vite",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:update": "npm run build && electron-builder --win"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "my.eschool.fynance",
    "productName": "FYnance",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python/dist",
        "to": "python"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FYnance",
      "differentialPackage": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "assets/icon.png",
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "flatpak"
      ],
      "category": "Finance",
      "icon": "assets/icon.png",
      "maintainer": "ESchool Tools",
      "synopsis": "FYnance — Foon Yew e-wallet dashboard",
      "description": "Automated balance & spending tracker for the Foon Yew eschool e-wallet."
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZX-159",
        "repo": "FYnance",
        "releaseType": "release"
      }
    ]
  },
  "productName": "FYnance",
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
